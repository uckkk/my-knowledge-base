  "motion": {
    "note": "spring(duration: d, bounce: b) ≈ spring(response: d, dampingFraction: 1 − b)。response 是 SwiftUI 弹簧参数，不是 CSS 秒数，不要直接写成 transition: 0.32s。",
    "presets": {
      "press": {
        "response": 0.2,
        "dampingFraction": 0.9,
        "bounce": 0.1,
        "use": "按下 / 抬起",
        "reduceMotion": {
          "timing": "easeOut",
          "durationSeconds": 0.1
        }
      },
      "snap": {
        "response": 0.32,
        "dampingFraction": 0.82,
        "bounce": 0.18,
        "use": "开关、分段、选中、数字变化",
        "reduceMotion": {
          "timing": "easeInOut",
          "durationSeconds": 0.15
        }
      },
      "glide": {
        "response": 0.45,
        "dampingFraction": 1.0,
        "bounce": 0,
        "use": "布局、展开、面板",
        "reduceMotion": {
          "timing": "easeInOut",
          "durationSeconds": 0.2
        }
      },
      "reward": {
        "response": 0.55,
        "dampingFraction": 0.7,
        "bounce": 0.3,
        "use": "结果出现、完成、购买成功（每屏最多一次）",
        "reduceMotion": {
          "timing": "easeOut",
          "durationSeconds": 0.25
        }
      }
    },
    "reduceMotionRule": "减弱动态效果开启时：去掉位移和缩放，只做短淡入淡出（源码精确值，不是把弹簧 response 拿来当时长）",
    "reveal": {
      "insert": "淡入 + 上移 8pt + 缩放 0.96→1",
      "remove": "仅淡出",
      "reduceMotion": "去掉位移和缩放，只留淡入淡出",
      "translateY": 8,
      "scaleFrom": 0.96
    },
    "pressScale": {
      "defaultScale": 0.97,
      "brightness": -0.04,
      "reduceMotion": "不缩放，改为透明度 0.8",
      "reduceMotionOpacity": 0.8,
      "paywallPlanCardScale": 0.98,
      "sheetCloseButtonScale": 0.9
    }
  },
  "haptics": {
    "principle": "触感只确认「已发生」的事；滚动、浏览、导航不震。Web 没有等价 UIKit 触感，不要假装已接入 iOS Taptic Engine。",
    "events": {
      "tap": {
        "use": "主按钮提交",
        "implementation": "Impact .medium 0.7"
      },
      "select": {
        "use": "分段切换、滑杆刻度、面板档位",
        "implementation": "Selection"
      },
      "toggleOn": {
        "use": "开关打开",
        "implementation": "Impact .light 0.9"
      },
      "toggleOff": {
        "use": "开关关闭",
        "implementation": "Impact .soft 0.6"
      },
      "edge": {
        "use": "滑杆到端点",
        "implementation": "Impact .rigid 0.6"
      },
      "threshold": {
        "use": "滑动操作越过阈值",
        "implementation": "Impact .medium 0.8"
      },
      "reveal": {
        "use": "结果卡出现",
        "implementation": "Impact .soft 0.5"
      },
      "success": {
        "use": "复制、保存、购买成功",
        "implementation": "Notification .success"
      },
      "warning": {
        "use": "可恢复问题",
        "implementation": "Notification .warning",
        "note": "README 触感表未列出 warning，源码有。"
      },
      "error": {
        "use": "输入错误、购买失败",
        "implementation": "Notification .error"
      }
    }
  },
